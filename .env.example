# Self-host secrets for docker-compose.selfhost.yml.
#   cp .env.example .env  &&  fill EVERY value below, then `docker compose -f docker-compose.selfhost.yml up --build`.
# `.env` is gitignored — never commit real secrets. The compose fails fast if any are empty.

# Postgres bootstrap superuser password (DB is internal to the compose network).
POSTGRES_PASSWORD=
# DB role passwords (lumnik_app / lumnik_admin BYPASSRLS / lumnik_readonly) —
# up.sh generates all three; rotation = new value here, then re-run up.sh.
LUMNIK_APP_DB_PASSWORD=
LUMNIK_ADMIN_DB_PASSWORD=
LUMNIK_READONLY_DB_PASSWORD=

# Keycloak admin console password (the console is published on :8180).
KEYCLOAK_ADMIN_PASSWORD=

# Encryption keys that protect stored secrets at rest. Generate strong values:
#   openssl rand -base64 32
LUMNIK_SECRET_MASTER_KEY=
LUMNIK_CRYPTO_SECRET_KEY=

# Secret of the entity-resolution fingerprint HMAC (the hub refuses to boot without a real one).
#   openssl rand -base64 32
LUMNIK_ENTITY_RESOLUTION_HMAC_SECRET=

# Per-install password for the hubadmin demo admin (the realm ships it with NO
# credential; up.sh sets this via the Keycloak admin API once the stack is healthy)
HUBADMIN_PASSWORD=

# Per-install password for the integrator demo user (same NO-credential posture as
# hubadmin above; up.sh sets this via the Keycloak admin API once the stack is healthy)
INTEGRATOR_PASSWORD=

# Optional overrides (safe defaults if omitted): POSTGRES_USER=lumnik KEYCLOAK_ADMIN=admin

# Optional: pin the published hub image tag (default: `main`, the latest main build).
# Pin a release once tagged — see deploy/selfhost/README.md.
#LUMNIK_VERSION=main

# ── Optional knobs (application defaults apply when unset) ──────────────────
# Where the hub reaches Ollama (default: the host, via host.docker.internal):
#OLLAMA_BASE_URL=http://host.docker.internal:11434
# Model choices for the AI layer (see docs/rag/models.md):
#RAG_CHAT_MODEL=llama3.2
#ASK_SQL_MODEL=qwen2.5-coder:7b
#ASK_SQL_NUM_CTX=32768
#ASK_SQL_NUM_PREDICT=1024
#LUMNIK_ASK_ANSWER_BUDGET_CHARS=6000
#JUDGE_MODEL=gemma4
#RAG_EMBEDDING_MODEL=nomic-embed-text
# Event outbox retention window, in days (see docs/operations/observability.md):
#LUMNIK_EVENTS_RETENTION_DAYS=30
# Audit log retention (core.audit_event), days; 0 = keep forever (explicit choice)
#LUMNIK_AUDIT_RETENTION_DAYS=365
# Webhook delivery journal retention (core.webhook_delivery: payloads and responses, what `lm outputs` lists and
# replay re-sends), days; 0 = keep forever (explicit choice)
#LUMNIK_WEBHOOKS_DELIVERY_RETENTION_DAYS=90
# Durable run queue: a manual connector run or an on-demand export run is accepted as a `queued` run and started as a slot frees (default off;
# turn it on only once every hub replica runs this release). A run still queued after MAX_AGE ends: a connector run Cancelled, an export run Failed (interrupted).
#LUMNIK_RUN_QUEUE_ENABLED=false
#LUMNIK_RUN_QUEUE_MAX_AGE=1h
#LUMNIK_RUN_QUEUE_POLL_INTERVAL=5s
# The AI family (chat, ask, embeddings, view generation): `false` switches it off. The modules stay installed and
# listed (lm module list shows them INACTIVE), their data is kept, nothing calls a model, the PWA has no Chat tab.
# Exactly `true` or `false` — anything else stops the hub at startup. A change takes a restart.
#LUMNIK_AI_ENABLED=true
# Ask the IdP's UserInfo endpoint on every request, so an account disabled in the IdP is refused
# on its next request instead of at token expiry (one IdP round trip per request; default off):
#LUMNIK_AUTH_VERIFY_WITH_IDP=true
# Email delivery (both required to go live; the hub WARNs at boot if only the host is set):
#LUMNIK_SMTP_HOST=smtp.example.com
#LUMNIK_SMTP_MOCK=false
# Optional: LUMNIK_SMTP_PORT=587  LUMNIK_SMTP_USERNAME=  LUMNIK_SMTP_PASSWORD=  LUMNIK_SMTP_FROM=lumnik@example.com  LUMNIK_SMTP_STARTTLS=REQUIRED
