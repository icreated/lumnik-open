# scripts/wow/.env.example — copy to scripts/wow/.env and fill in. .env is gitignored.
export WOW_SERVER="http://localhost:8080"
export WOW_TENANT_ID="1"
export WOW_SCOPE="atelier"

# Live Adempiere source (ingest + fixture capture)
export WOW_SRC_URL="jdbc:postgresql://HOST:5432/adempiere"
export WOW_SRC_USER="adempiere"
export WOW_SRC_PASSWORD="CHANGEME"

# Hub Postgres (reference SQL runs here, read-only)
export WOW_HUB_HOST="localhost"
export WOW_HUB_PORT="5433"
export WOW_HUB_DB="lumnik"
export WOW_RO_USER="lumnik_readonly"
export WOW_RO_PASSWORD="lumnik_readonly_dev_password"
