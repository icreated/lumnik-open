<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.lumnik</groupId>
        <artifactId>lumnik</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>lumnik-llm-spi</artifactId>
    <name>lumnik :: LLM SPI</name>
    <description>Neutral LLM primitives: ChatPort, EmbeddingPort, ChatMessage, Role.</description>

    <dependencies>
        <!-- @Qualifier for the @Analytic ChatPort selector (annotations only; no CDI container) -->
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Produce a Jandex index so Quarkus ARC recognizes @Analytic as a qualifier
                 (otherwise AnalyticChatPort would fall back to @Default and clash with the
                 conversational ChatPort). Mirrors lumnik-llm-langchain. -->
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
