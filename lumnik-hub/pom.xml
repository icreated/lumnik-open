        <!-- ── Apache MINA SSHD (SFTP file source) ─────────────────── -->
        <!-- Keep sshd-sftp/core/common on the SAME version: a transitively-pulled older
             sshd-common once broke the EdDSA key exchange ("key spec not recognised"). -->
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-sftp</artifactId>
            <version>2.19.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-core</artifactId>
            <version>2.19.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-common</artifactId>
            <version>2.19.0</version>
        </dependency>
        <!-- Ed25519 host keys ride Bouncy Castle (sshd's supported provider since 2.15;
             the unmaintained net.i2p.crypto:eddsa carried a signature-malleability advisory).
             Compile scope so the JCE provider and key types are loaded by the same
             classloader as sshd-common in @QuarkusTest — a split loader once yielded
             "key spec not recognised" (see parent-first-artifacts in test properties). -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.85.2</version>
        </dependency>

        <!-- ── WireMock (REST connector IT harness) ─────────────────── -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.9.1</version>
            <scope>test</scope>
        </dependency>

        <!-- ── Testing ─────────────────────────────────────────────── -->
        <!-- Shared fixtures: the CDI mock LLM ports that keep ARC validation satisfied when
             lumnik-llm-langchain is absent from the test classpath. The test scope is
             load-bearing: the testkit's @Mock alternatives would shadow the real LLM ports
             on a runtime classpath. -->
        <dependency>
            <groupId>io.lumnik</groupId>
            <artifactId>lumnik-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-security-jwt</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-redpanda</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit-mockito</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
      The open/closed line, made buildable (publication ritual, Act 1 seam 3).

      The open edition ships the hub without lumnik-rag and lumnik-llm-langchain. The SPIs stay
      on BOTH sides — lumnik-llm-spi holds only interfaces (ChatPort, EmbeddingPort, @Analytic,
      @Judge) and the hub's main code compiles against them, exactly as it does against
      lumnik-extraction-spi. A seam ships with the side that declares it.

      Every LLM injection point in the hub is an `Instance<…>`, so Arc starts cleanly with no
      implementation present and the feature degrades instead of failing. That is the claim this
      profile exists to TEST rather than assert: `mvn -DopenEdition …` builds the edition the
      public repo would ship, and scripts/check-open-edition-boots.sh boots it for real.

      Default (no flag) = the full edition, byte-for-byte what it was before this profile existed.
    -->

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <!-- @{argLine} late-binding picks up the JaCoCo -javaagent. -->
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <!-- See surefire note above. -->
                        <api.version>1.41</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Aggregate JaCoCo XML across all modules for Sonar.
                 lumnik-hub depends (directly or transitively) on every module,
                 so report-aggregate sees all class files and exec data. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-report-aggregate</id>
                        <phase>verify</phase>
                        <goals><goal>report-aggregate</goal></goals>
                        <configuration>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco-aggregate</outputDirectory>
                            <!-- Include lumnik-hub classes + exec data (not just dependency modules) -->
                            <includeCurrentProject>true</includeCurrentProject>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
