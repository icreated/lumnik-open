        </dependency>
        <dependency>
            <groupId>io.lumnik</groupId>
            <artifactId>lumnik-llm-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The two closed-edition modules live in the `closed-extensions` profile below, so that
             an open-edition build is something we RUN rather than something we assume. -->

