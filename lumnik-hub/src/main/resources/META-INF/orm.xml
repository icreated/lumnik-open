<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm
                   https://jakarta.ee/xml/ns/persistence/orm/orm_3_0.xsd"
                 version="3.1">
  <persistence-unit-metadata>
    <persistence-unit-defaults>
      <!--
        AuditEntityListener is registered globally so module entities don't need to
        reference a class from lumnik-platform (which would create a circular dep).
        The listener checks for @Auditable at runtime and no-ops if absent.
      -->
      <entity-listeners>
        <entity-listener class="io.lumnik.hub.audit.AuditEntityListener"/>
      </entity-listeners>
    </persistence-unit-defaults>
  </persistence-unit-metadata>
</entity-mappings>
