# One TLS façade for the whole self-host stack — a single https origin serves
# Keycloak (path-proxied) and the hub, so browsers see no mixed content, no CORS,
# and ONE issuer for every device.
#
# LUMNIK_TLS_HOST decides the certificate story, automatically:
#   - a real public domain  → Caddy obtains/renews Let's Encrypt certificates
#   - a LAN IP or localhost → Caddy issues from its internal CA (trust it on your
#     devices for a clean padlock: the root cert lives in the caddy_data volume,
#     see deploy/tls/README.md)
{
	# clients dialing a bare IP send no SNI (RFC 6066) — without this, Caddy finds
	# no certificate and aborts every handshake with alert 80
	default_sni {$LUMNIK_TLS_HOST}
}

{$LUMNIK_TLS_HOST} {
	# HSTS (#1994), only when LUMNIK_TLS_HSTS=true: a public domain with a public certificate. On a LAN name with
	# Caddy's internal CA, a lost caddy_data volume would lock every device that saw it out for a year, and on
	# localhost it would pin https on every port of the machine. No includeSubDomains: the domain may hold other hosts.
	@hsts expression `{env.LUMNIK_TLS_HSTS} == "true"`
	header @hsts Strict-Transport-Security "max-age=31536000"

	# Keycloak, same-origin under /realms + its static assets. Its own Strict-Transport-Security (a year, with
	# includeSubDomains) is dropped: this façade alone decides HSTS for the origin.
	handle /realms/* {
		reverse_proxy keycloak:8180 {
			header_down -Strict-Transport-Security
		}
	}
	handle /resources/* {
		reverse_proxy keycloak:8180 {
			header_down -Strict-Transport-Security
		}
	}

	# The hub serves nothing under /q on its public port (#1993: health, metrics and the spec are on its management
	# port, which this façade never reaches); refused here as well, in case a build serves one again.
	handle /q/* {
		respond 404
	}

	# everything else is the hub (API + the /app/ PWA)
	handle {
		reverse_proxy hub:8080
	}
}
